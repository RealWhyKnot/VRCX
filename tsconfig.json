{
  "include": ["src/**/*", "src-electron/**/*", "build-scripts/**/*", "*.config.js", "tests/**/*"],
  "compilerOptions": {
    "module": "preserve",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "checkJs": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "allowJs": true,
    "types": ["vite/client", "node"],
    "jsxImportSource": "vue",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"]
    },
    "target": "ESNext",
    "jsx": "preserve",
    "forceConsistentCasingInFileNames": true
  },
  "extends": "./.github/lint/tsconfig.base.json"
}
